# Database
DATABASE_URL=postgresql://korobkov:korobkov@localhost:5432/korobkov

# NextAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 (optional)
# When set, artwork images are served from R2 instead of /public/
# Example: https://images.korobkovart.com
R2_PUBLIC_URL=

# Telegram bot (managed via Infisical in prod, path=/korobkov)
# Token used by both site notifications (sendTelegramNotification) and bot/index.js poller
TG_BOT_KO=
TG_CHAT_ID=

